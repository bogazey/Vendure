# Copy to .env.production on the server. Never commit the populated file.
APP_ENV=production
# Set to resend to enable delivery; disabled suppresses all email.
# The log backend is development-only.
EMAIL_BACKEND=disabled
RESEND_API_KEY=
# Use a sender on your verified Resend domain.
EMAIL_FROM=Loady <noreply@loady.cc>
# Delivery errors are logged without message contents; no automatic retries.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://loady:replace-with-a-long-random-value@postgres:5432/loady
POSTGRES_DB=loady
POSTGRES_USER=loady
POSTGRES_PASSWORD=replace-with-a-long-random-value
COOKIE_SECURE=true
COOKIE_DOMAIN=
FRONTEND_BASE_URL=https://loady.cc

DOWNLOAD_ROOT=/var/lib/loady/media
LMD_DATA_DIR=/var/lib/loady/data
LMD_LOG_DIR=/var/lib/loady/data/logs
LMD_DB_PATH=/var/lib/loady/data/app.db
LMD_DOWNLOAD_DIR=/var/lib/loady/media
LMD_MAX_CONCURRENT_DOWNLOADS=1
DIRECT_IMAGE_MAX_BYTES=52428800
AUTHENTICATED_MEDIA_TTL_HOURS=24
PARTIAL_MEDIA_TTL_HOURS=6
MEDIA_CLEANUP_INTERVAL_MINUTES=60
MEDIA_MAX_BYTES=42949672960

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
GUEST_DOWNLOAD_LIMIT=5
GUEST_DATA_TTL_HOURS=48
ADS_ENABLED=true

PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
PADDLE_CREATOR_MONTHLY_PRICE_ID=
PADDLE_CREATOR_ANNUAL_PRICE_ID=

# Build-time frontend values. Empty API base means same-origin /api requests.
VITE_API_BASE_URL=
VITE_SITE_URL=https://loady.cc

# --- Platform Core central identity integration (Mission 15, Phase 7) ---
# Leave PLATFORM_CLIENT_ID empty to keep the integration dormant, exactly
# as real production runs today - every route in routes_platform_auth.py
# 404s cleanly rather than half-configuring itself. Do not set any of
# these for a Loady-only deployment. See docs/platform/
# LOADY_PRODUCTION_MIGRATION_PLAN.md and PRODUCTION_ENVIRONMENT_INVENTORY.md
# before ever setting PLATFORM_CLIENT_ID in a real environment.
PLATFORM_AUTH_BASE_URL=https://id.loady.cc
PLATFORM_API_BASE_URL=https://id.loady.cc
PLATFORM_INTERNAL_BASE_URL=http://platform-core-backend:8000
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
PLATFORM_REDIRECT_URI=https://loady.cc/api/auth/platform/callback
PLATFORM_TOKEN_ENCRYPTION_KEY=
ENTITLEMENT_CACHE_TTL_MINUTES=15
SESSION_REVALIDATION_INTERVAL_MINUTES=5
PLATFORM_AUTH_ENABLED=true
PLATFORM_ENTITLEMENTS_ENABLED=true
PLATFORM_BILLING_ENABLED=true
