# Commercial layer configuration.
#
# Copy this file to backend/.env (same directory as this file) and fill in
# real values. This is read only by app/config/commercial_settings.py - the
# original personal-app settings (download folder, quality, etc.) are
# unrelated and live in the ../.env.example at the project root instead.
#
# Never commit a real .env file - it's already gitignored.

# --- Auth / sessions -------------------------------------------------------
# Required beyond local dev: without it, a random secret is generated per
# process start and every session is invalidated on restart. Generate one
# with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access tokens are short-lived JWTs; refresh tokens are longer-lived and
# individually revocable (see app/database/commercial_models.RefreshToken).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cookies are httpOnly always. COOKIE_SECURE must be true in any deployment
# served over HTTPS (i.e. anywhere but local http://127.0.0.1 dev).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Database ---------------------------------------------------------------
# Defaults to sqlite:///<project>/data/commercial.db if unset. Point this at
# PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=

# --- Paddle (Billing) --------------------------------------------------------
# This build is hard-restricted to Paddle Sandbox - see PADDLE_SANDBOX_TESTING.md.
# Never put live/production Paddle credentials here.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
PADDLE_CREATOR_MONTHLY_PRICE_ID=
PADDLE_CREATOR_ANNUAL_PRICE_ID=

# --- Ads ---------------------------------------------------------------------
# Architecture only - no ad network is actually wired up yet. This just
# controls whether AdSlot placeholders render for Free-plan accounts.
ADS_ENABLED=true

# --- Frontend origin (used to build email links) -----------------------------
FRONTEND_BASE_URL=http://127.0.0.1:5173
