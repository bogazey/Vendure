# Loady STAGING environment (mission 4, phase 13). Copy to .env.staging
# and fill in real values — .env.staging is gitignored and must never be
# committed, and must never contain a real customer's data or Paddle Live
# credentials. Synthetic accounts only.

APP_ENV=staging
SECRET_KEY=replace-with-a-long-random-value

# --- Database (PostgreSQL — a separate staging DB/volume, never the real
# production database) ---
POSTGRES_DB=loady_staging
POSTGRES_USER=loady_staging
POSTGRES_PASSWORD=replace-with-a-long-random-value

COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_BASE_URL=http://localhost:8090

# --- Storage (matches the mount points in compose.staging.yml) ---
DOWNLOAD_ROOT=/var/lib/loady/media
LMD_DATA_DIR=/var/lib/loady/data
LMD_LOG_DIR=/var/lib/loady/data/logs
LMD_DB_PATH=/var/lib/loady/data/app.db
LMD_DOWNLOAD_DIR=/var/lib/loady/media
LMD_MAX_CONCURRENT_DOWNLOADS=1

# --- Platform Core central identity (staging) ---
# PLATFORM_AUTH_BASE_URL/PLATFORM_API_BASE_URL: the externally reachable
# Platform Core staging host (browser redirects + id_token issuer check).
# PLATFORM_INTERNAL_BASE_URL: the private docker-network address Loady's
# own backend actually calls for server-to-server requests (token
# exchange, JWKS, entitlement/status lookups) - requires both stacks on
# the shared `platform-staging-net` external network (see
# docs/platform/STAGING_DEPLOYMENT.md).
PLATFORM_AUTH_BASE_URL=https://platform-staging.local:8443
PLATFORM_API_BASE_URL=https://platform-staging.local:8443
PLATFORM_INTERNAL_BASE_URL=http://platform-core-backend:8000
PLATFORM_CLIENT_ID=loady
PLATFORM_CLIENT_SECRET=replace-with-the-secret-printed-by-register_loady_client
PLATFORM_REDIRECT_URI=http://localhost:8090/api/auth/platform/callback

# Refresh/access token encryption at rest (mission 4, phase 4) - a real
# 32-byte base64 key, distinct from SECRET_KEY and from Platform Core's
# own signing key. Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PLATFORM_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# --- Paddle: sandbox only, staging must never reach Paddle Live ---
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

ADS_ENABLED=false

# Build-time frontend values.
VITE_API_BASE_URL=
VITE_SITE_URL=http://localhost:8090

LOADY_STAGING_HTTP_PORT=8090
