# Mission 7, Phase 18 — combined production edge for Loady + Platform Core.
#
# This is an envsubst TEMPLATE (official nginx image convention: any file
# under /etc/nginx/templates/*.template is rendered to
# /etc/nginx/conf.d/<name>.conf at container start, substituting only
# environment variables that are actually set — nginx's own runtime `$foo`
# variables, like $host or $remote_addr, are never exported as env vars so
# they pass through untouched; see docker-library/docs/nginx for this
# exact pattern). The four RC_*_HOSTNAME vars below are the ONLY
# substitutions this file performs — see compose.rc.yml.
#
# Extends (does not replace) frontend/nginx.tls.conf's loady.cc server
# block, per docs/platform/PRODUCTION_TOPOLOGY.md's "one edge, name-based
# virtual hosts" design. TLS cert/key and Cloudflare real-IP restoration
# are shared across every server block below (single cert covering all
# four hostnames, e.g. a wildcard `*.loady.cc` + apex — provisioned out of
# band, see MISSION_7_DNS_TLS_RUNBOOK.md).
#
# Cloudflare real-IP restoration is inlined here (identical values to
# frontend/cloudflare-realip.conf) rather than mounted as a second file:
# this template already renders into /etc/nginx/conf.d/default.conf at
# container start via envsubst, and layering a second runtime mount over
# the same read-only, tmpfs-backed conf.d directory is an unnecessary
# mount-ordering risk for no benefit. Keep both copies in sync if
# Cloudflare's published ranges ever change.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

server {
    listen 80;
    server_name ${RC_LOADY_HOSTNAME} www.${RC_LOADY_HOSTNAME} ${RC_PLATFORM_AUTH_HOSTNAME} ${RC_ACCOUNT_HOSTNAME} ${RC_ADMIN_HOSTNAME};
    return 301 https://$host$request_uri;
}

# --- loady.cc : unchanged from frontend/nginx.tls.conf, condensed here so
# one file is the single source of truth for the combined edge. If Loady's
# own routing changes, mirror the change in frontend/nginx.tls.conf too
# (that file remains authoritative for Loady-only deployments that don't
# include Platform Core, e.g. local dev).
server {
    listen 443 ssl;
    http2 on;
    server_name ${RC_LOADY_HOSTNAME};
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location = /api/progress/stream {
        proxy_pass http://loady-backend:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        proxy_pass http://loady-backend:8000;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
    }
    location ~* ^/assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location = /robots.txt { try_files $uri =404; }
    location = /sitemap.xml { try_files $uri =404; }
    location ~ ^/(en|ar)(/(video-downloader|audio-downloader|image-downloader))?/?$ { try_files $uri $uri/index.html =404; }
    location = / { try_files /index.html =404; }
    location ~ ^/(pricing|login|signup|forgot-password|reset-password|verify-email|terms|privacy|copyright|acceptable-use|refund-policy|dashboard|history|settings|account|billing|usage)/?$ { try_files /index.html =404; }
    location ~ ^/admin(/(users|billing|activity|system|ads|statistics))?/?$ { try_files /index.html =404; }
    location / { return 404; }
}

# --- Platform Core backend: OIDC/OAuth, JWKS, API, health/readiness -----
server {
    listen 443 ssl;
    http2 on;
    server_name ${RC_PLATFORM_AUTH_HOSTNAME};
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location ~ ^/(api/|oauth/|\.well-known/) {
        proxy_pass http://platform-core-backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /health {
        proxy_pass http://platform-core-backend:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /ready {
        proxy_pass http://platform-core-backend:8000/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # No admin UI is served here — this hostname is API/OIDC only.
    location / { return 404; }
}

# --- Account Portal -------------------------------------------------------
# Mission 15, Phase 12 fix: account-frontend/nginx.conf's own comment (and
# platform-core/.env.production.example's VITE_PLATFORM_API_BASE_URL=""
# default) both document a same-origin design - the SPA's JS is meant to
# call relative /api, /oauth, /.well-known paths on ITS OWN hostname and
# have this edge route them to platform-core-backend, exactly like the
# id.<domain> block below already does. That routing was missing here
# until this fix: every such call would have fallen through to the
# frontend container's own SPA catch-all (`try_files $uri /index.html`)
# and silently received index.html instead of JSON. Never exercised end to
# end before (no Docker daemon in any prior mission's sandbox - see
# FINAL_PREPRODUCTION_EVIDENCE_AUDIT.md), so this was never observed.
server {
    listen 443 ssl;
    http2 on;
    server_name ${RC_ACCOUNT_HOSTNAME};
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location ~ ^/(api/|oauth/|\.well-known/) {
        proxy_pass http://platform-core-backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://platform-core-account-frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

