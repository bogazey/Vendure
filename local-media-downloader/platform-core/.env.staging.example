# Platform Core staging environment (mission 4). Copy to .env.staging and
# fill in real values — .env.staging is gitignored and must never be
# committed. See docs/platform/STAGING_DEPLOYMENT.md for the full runbook,
# including how to generate each secret below.

APP_ENV=staging

# --- Database (PostgreSQL — mission 4 phase 2; SQLite is not used in
# staging/production) ---
# DATABASE_URL itself is composed by compose.staging.yml from the three
# vars below — set them here, not DATABASE_URL directly.
POSTGRES_DB=platform_core_staging
POSTGRES_USER=platform_core_staging
POSTGRES_PASSWORD=replace-with-a-long-random-value

# --- Central identity domains ---
# The externally reachable staging hostname (this reverse proxy) — never
# a final production domain (mission-brief section 6). Used as the OAuth
# authorize/callback base the browser navigates to, and as the JWT
# `iss`/JWKS base other services verify against.
PLATFORM_AUTH_BASE_URL=https://platform-staging.local:8443
PLATFORM_API_BASE_URL=https://platform-staging.local:8443

# --- Session cookies ---
COOKIE_SIGNING_KEY=replace-with-a-long-random-value
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- RS256 signing key (mission 4 phase 3) ---
# Generated out of band by ./backend/generate-staging-signing-key.sh —
# never generated by the container in staging/production (see
# app/security/jwt_keys.py, fails closed if this file is missing).
JWT_PRIVATE_KEY_PATH=/run/secrets/platform-signing-key.pem
JWT_KEY_ID=platform-core-staging-1

# --- Admin frontend build ---
# Empty = same-origin (the reverse proxy routes /api,/oauth,/.well-known
# on this same host to the backend) — see admin-frontend/src/services/api.ts.
VITE_PLATFORM_API_BASE_URL=

# --- Reverse proxy host ports ---
PLATFORM_STAGING_HTTPS_PORT=8443
PLATFORM_STAGING_HTTP_PORT=8091

# --- Email (dev/test backend only — never configure production Resend here) ---
EMAIL_BACKEND=log
