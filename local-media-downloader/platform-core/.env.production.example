# Platform Core PRODUCTION environment, for use with the combined
# compose.rc.yml (Mission 7, Phase 18/19). Copy to platform-core/.env.production
# and fill in real values — this file (and the copy) must never be committed
# with real secrets. See docs/platform/MISSION_7_PRODUCTION_TOPOLOGY.md and
# MISSION_7_PRODUCTION_CUTOVER_RUNBOOK.md for the full runbook.
#
# DATABASE_URL is NOT set here — compose.rc.yml composes it directly from
# PLATFORM_POSTGRES_DB/USER/PASSWORD in the top-level .env.rc file, exactly
# like Loady's own POSTGRES_* vars compose its DATABASE_URL. Do not set
# DATABASE_URL here; it would be overridden anyway (compose `environment:`
# always wins over `env_file`) and its presence here would be misleading.

APP_ENV=production

# --- Central identity domains ---
# The REAL, externally reachable production hostname for Platform Core's
# own backend (OIDC/OAuth/API) — see MISSION_7_PRODUCTION_TOPOLOGY.md's
# "Recommended hostname structure" for the two real options (subdomain of
# loady.cc vs. a separate ecosystem domain). Must match RC_PLATFORM_AUTH_HOSTNAME
# in the top-level .env.rc file exactly — this is the JWT `iss`/JWKS base
# every other service verifies against, not just a display string.
PLATFORM_AUTH_BASE_URL=https://id.loady.cc
PLATFORM_API_BASE_URL=https://id.loady.cc

# --- Session cookies ---
COOKIE_SIGNING_KEY=replace-with-a-long-random-value
COOKIE_SECURE=true
# Leave empty unless Account Portal / Grand Admin / Platform Core backend
# deliberately share a single cookie-domain suffix in your chosen hostname
# structure - see MISSION_7_PRODUCTION_TOPOLOGY.md.
COOKIE_DOMAIN=

# --- RS256 signing key ---
# Generated out of band (see docs/platform/KEY_ROTATION_RUNBOOK.md) - never
# generated by the container in production (app/security/jwt_keys.py fails
# closed if this file is missing, by design). Path is inside the container;
# compose.rc.yml mounts PLATFORM_SIGNING_KEY_PATH (a HOST path, set in the
# top-level .env.rc) to exactly this location.
JWT_PRIVATE_KEY_PATH=/run/secrets/platform-signing-key.pem
JWT_KEY_ID=platform-core-2026-1

# --- Account Portal / Grand Admin frontend build ---
# Empty = same-origin (the combined edge routes /api,/oauth,/.well-known on
# each frontend's own hostname to platform-core-backend) - see
# account-frontend/src/services/api.ts and admin-frontend's equivalent.
# This var name is shared by both frontend build args in compose.rc.yml.
VITE_PLATFORM_API_BASE_URL=

# --- Email ---
# EMAIL_BACKEND=log is safe as a rehearsal default but MUST be changed
# before a real cutover - Platform Core's own transactional email
# (verification, password reset) needs a real backend in production,
# exactly like Loady's own EMAIL_BACKEND requirement.
EMAIL_BACKEND=log
