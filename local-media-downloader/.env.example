# Copy this file to .env in the project root and adjust as needed.
# All variables are optional; sensible local defaults are used otherwise.

# Backend data locations (advanced; usually leave these alone)
# LMD_DATA_DIR=./data
# LMD_LOG_DIR=./data/logs
# LMD_DB_PATH=./data/app.db
# LMD_DOWNLOAD_DIR=./downloads

# Backend bind address (must stay local for security; do not expose remotely)
LMD_BACKEND_HOST=127.0.0.1
LMD_BACKEND_PORT=8000

# Frontend dev server port
LMD_FRONTEND_PORT=5173

# Frontend -> backend API base URL used by the Vite dev server
VITE_API_BASE_URL=http://127.0.0.1:8000
