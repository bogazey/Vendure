# Top-level orchestration env for compose.rc.yml (Mission 7, Phase 18/19) -
# the combined Loady + Platform Core production-shaped stack. Copy to
# .env.rc and fill in real values; .env.rc is gitignored and must never be
# committed. See docs/platform/MISSION_7_PRODUCTION_TOPOLOGY.md and
# MISSION_7_PRODUCTION_CUTOVER_RUNBOOK.md for the full runbook.
#
# This file only sets vars compose.rc.yml itself reads directly (hostnames,
# ports, the two Postgres credential sets, and paths to the per-service env
# files/secrets). Loady's own application config still lives in
# .env.production (LOADY_ENV_FILE below); Platform Core's in
# platform-core/.env.production (PLATFORM_ENV_FILE below) - copy
# platform-core/.env.production.example there too.
#
# ---------------------------------------------------------------------------
# LOCAL REHEARSAL WARNING (Phase 19): if a real production stack (or
# anything else) is already bound to host ports 80/443 on this machine,
# the defaults below WILL collide with it. A rehearsal run MUST override
# RC_HTTP_PORT/RC_HTTPS_PORT to unused ports (e.g. 8280/8543) and use
# `docker compose -p loady-rc ...` (already set via `name: loady-rc` in
# compose.rc.yml) so it never touches an existing project's containers,
# networks, or volumes. Check `docker ps` first regardless.
# ---------------------------------------------------------------------------

# --- Hostnames (all four, no hard-coded default beyond loady.cc itself -
# see MISSION_7_PRODUCTION_TOPOLOGY.md "Recommended hostname structure")---
RC_LOADY_HOSTNAME=loady.cc
RC_PLATFORM_AUTH_HOSTNAME=id.loady.cc
RC_ACCOUNT_HOSTNAME=account.loady.cc
RC_ADMIN_HOSTNAME=admin.loady.cc

# --- Edge ports (real production: leave at the compose defaults, 80/443,
# by not setting these at all; a local rehearsal MUST override both -
# see warning above) ---
# RC_HTTP_PORT=80
# RC_HTTPS_PORT=443

# --- TLS ---
# Directory containing fullchain.pem/privkey.pem for RC_LOADY_HOSTNAME and
# the three Platform Core hostnames (a real cert covering all four, or one
# per hostname - see nginx.production.conf.template). For a local
# rehearsal, generate self-signed certs (see
# platform-core/reverse-proxy/generate-staging-cert.sh for the pattern)
# and point RC_TLS_DIR at them instead.
RC_TLS_DIR=./secrets/tls

# --- Loady (unchanged from a Loady-only deployment) ---
LOADY_ENV_FILE=.env.production
POSTGRES_DB=loady_production
POSTGRES_USER=loady_production
POSTGRES_PASSWORD=replace-with-a-long-random-value
VITE_API_BASE_URL=
VITE_SITE_URL=https://loady.cc

# --- Platform Core ---
PLATFORM_ENV_FILE=./platform-core/.env.production
PLATFORM_POSTGRES_DB=platform_core_production
PLATFORM_POSTGRES_USER=platform_core_production
PLATFORM_POSTGRES_PASSWORD=replace-with-a-different-long-random-value
# HOST path to the RS256 signing key (see docs/platform/KEY_ROTATION_RUNBOOK.md) -
# mounted read-only into platform-core-backend at /run/secrets/platform-signing-key.pem.
PLATFORM_SIGNING_KEY_PATH=./platform-core/secrets/platform-signing-key.pem
# Shared by both Account Portal and Grand Admin frontend builds - empty
# means same-origin (see platform-core/.env.production.example).
VITE_PLATFORM_API_BASE_URL=
